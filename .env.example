# ==========================================================================
# Clinic Management System — environment template
# Copy to `.env` and adjust for your machine. NEVER commit real secrets.
# ==========================================================================

# PostgreSQL connection string (docker-compose dev defaults shown)
DATABASE_URL="postgresql://clinic:clinic_dev_password@localhost:5432/clinic?schema=public"

# Separate database used by the automated test suite (vitest)
DATABASE_URL_TEST="postgresql://clinic:clinic_dev_password@localhost:5432/clinic_test?schema=public"

# Secret used to sign session JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Session lifetime in minutes (default 720 = 12 hours)
SESSION_TTL_MINUTES=720

# File storage. Provider: "local" (default) or "s3" (needs credentials below)
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Optional S3-compatible storage (used when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=clinic-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Messaging provider: "mock" (default, logs everything, no real sends) or "disabled"
MESSAGING_PROVIDER=mock

# Optional real WhatsApp/SMS provider credentials (leave empty; not required for dev)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
SMS_API_KEY=
SMS_SENDER_ID=

# App URL used for absolute links (cookies, exports)
NEXT_PUBLIC_APP_URL=http://localhost:3000
